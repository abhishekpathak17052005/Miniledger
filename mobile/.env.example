# MiniLedger Mobile API Configuration
#
# Choose the appropriate URL for your development target:
#
# 1. Web browser & iOS Simulator:
EXPO_PUBLIC_API_URL=http://localhost:4000
#
# 2. Android Emulator (10.0.2.2 accesses host machine's localhost):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
#
# 3. Physical Device running Expo Go (use your computer's local Wi-Fi IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.XX:4000
