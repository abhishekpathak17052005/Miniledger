generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LoanStatus {
  PENDING
  REPAID
}

model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  friends   Friend[]
  loans     Loan[]
}

model Friend {
  id             String   @id @default(cuid())
  userId         String
  name           String   @db.VarChar(80)
  normalizedName String   @db.VarChar(80)
  phone          String?  @db.VarChar(15)
  normalizedPhone String? @db.VarChar(15)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loans          Loan[]

  @@index([userId, normalizedName])
  @@index([userId, normalizedPhone])
}

model Loan {
  id                 String      @id @default(cuid())
  userId             String
  friendId           String?
  friendName         String      @db.VarChar(80)
  amount             Decimal     @db.Decimal(12, 2)
  dueDate            DateTime    @db.Date
  status             LoanStatus  @default(PENDING)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @default(now()) @updatedAt
  repaidAt           DateTime?
  customOverdueAmount Decimal?   @db.Decimal(12, 2)
  receiptPath        String?     @db.VarChar(255)
  receiptContentType String?     @db.VarChar(50)
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  friend             Friend?     @relation(fields: [friendId], references: [id], onDelete: SetNull)
  repayments         Repayment[]

  @@index([userId, status, dueDate])
  @@index([userId, createdAt])
  @@index([userId, friendId])
}

model Repayment {
  id       String   @id @default(cuid())
  loanId   String
  amount   Decimal  @db.Decimal(12, 2)
  repaidAt DateTime @default(now())
  note     String?  @db.VarChar(200)
  loan     Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@index([repaidAt])
}
