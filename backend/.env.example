# Database connection URL (PostgreSQL)
# Local PostgreSQL example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/miniledger?schema=public"
# Hosted PostgreSQL (Neon / Supabase IPv4 Pooler) example:
# DATABASE_URL="postgresql://postgres.yourproject:yourpassword@aws-0-region.pooler.supabase.com:5432/postgres"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# JWT Secret for authentication tokens (min 32 characters)
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Server Port
PORT=4000

# Environment
NODE_ENV=development
